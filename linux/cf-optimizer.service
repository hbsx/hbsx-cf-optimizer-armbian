[Unit]
Description=Scheduled official and reverse-proxy CF selection with Telegram reports
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
Type=oneshot
NotifyAccess=all
ExecStart=/bin/bash /opt/cf-optimizer/scheduled_scans.sh
ExecStopPost=/usr/local/sbin/cf-optimizer cleanup
TimeoutStartSec=84min
TimeoutStopSec=30s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
StandardOutput=null
StandardError=null
LogLevelMax=0
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=true
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
