PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFST_OUTPUT_DIR="/run/cf-optimizer"
# Calendar-day interval; install.sh appends CFST_SCHEDULE_ANCHOR once at install.
CFST_SCHEDULE_DAYS=3
CF_HEALTH_ENABLED=0
# CFST_SCHEDULE_ANCHOR="YYYY-MM-DD"
# Exact Cloudflare data-center code. NRT = Tokyo (Narita).
CFST_COLO="NRT"
CFST_TEST_URL="https://speed.cloudflare.com/__down?bytes=25000000"
CFST_TRACE_URL="https://www.cloudflare.com/cdn-cgi/trace"
CFST_TARGET_CIDRS="auto"
CFST_SEED_CIDRS="172.64.229.0/24"
# Manual `cf-optimizer --ipv6` only. Scheduled IPv4 scans remain unchanged.
# Candidate /48s live in ipv6-cidrs.txt; never enumerate a whole IPv6 subnet.
CFST_IPV6_SAMPLES_PER_CIDR=64
CFST_IPV6_NODE_PORT=2096
# Optional: real node TLS SNI/WS Host and path; configure both together locally.
CFST_IPV6_NODE_HOST=""
CFST_IPV6_NODE_PATH=""
CFST_FINE_SUBNETS=8
CFST_FINE_VERIFY=200
CFST_TEST_PORT=443
CFST_THREADS=50
CFST_PING_COUNT=4
CFST_DOWNLOAD_COUNT=5
CFST_DOWNLOAD_ATTEMPTS=20
CFST_DOWNLOAD_SECONDS=5
FAST_IP_EXIT_MBPS=5
FAST_IP_MAX_LATENCY_MS=250
FAST_IP_MAX_LOSS=0.1
FAST_POOL_MAX_SIZE=20
# Opt in only after configuring a Zone-scoped DNS Edit API Token and Zone ID.
CF_DNS_ENABLED=0
CF_DNS_NAME=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
# Empty = direct API requests. This never affects direct TCP measurements.
CF_DNS_API_PROXY_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_PROXY_URL="http://127.0.0.1:7890"
# Optional private-chat DNS control; run cf-optimizer-bot.service after enabling.
CF_TG_CONTROL_ENABLED=0
# Empty = the positive private-chat ID above. Never use a group ID here.
CF_TG_ALLOWED_USER_ID=""
CF_TG_DIRECT_INTERFACE="eth0"
# Existing FlClouds bot integration. Never enable both receivers.
CF_DNS_BRIDGE_ENABLED=0
CF_DNS_BRIDGE_URL=""
CF_DNS_BRIDGE_KEY=""
