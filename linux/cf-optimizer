#!/bin/bash
# Root-owned launcher: do not source any user-writable project file here.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $EUID == 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
mode="${1:---force}"
exec 9>/run/lock/cf-optimizer.lock
if ! flock -n 9; then
    [[ "$mode" == --health || "$mode" == cleanup-health ]] && exit 0
    echo 'Another scan is running.' >&2; exit 1
fi
uid=$(id -u cfoptimizer)
priority=8990
remove_rules() {
    for family in -4 -6; do
        while ip "$family" rule del pref "$priority" uidrange "$uid-$uid" lookup main 2>/dev/null; do :; done
    done
}
clean_runtime() {
    remove_rules
    if [[ -d /run/cf-optimizer && ! -L /run/cf-optimizer ]]; then
        find /run/cf-optimizer -mindepth 1 -maxdepth 1 ! -name best-ips.txt -exec rm -rf -- {} +
    fi
}
if [[ "$mode" == cleanup || "$mode" == cleanup-health ]]; then clean_runtime; exit 0; fi
case "$mode" in --check|--smoke|--force|--scheduled|--schedule-check|--health) ;; *) echo 'Usage: cf-optimizer [--check|--smoke|--force|--scheduled|--schedule-check|--health]' >&2; exit 2;; esac
if [[ "$mode" == --scheduled || "$mode" == --schedule-check ]]; then
    due=0
    runuser -u cfoptimizer -- env -i PATH="$PATH" PYTHONDONTWRITEBYTECODE=1 TZ=Asia/Shanghai \
        /bin/bash /opt/cf-optimizer/run_scan_linux.sh --schedule-check || due=$?
    if [[ "$mode" == --schedule-check ]]; then exit "$due"; fi
    if [[ "$due" == 1 ]]; then exit 0; fi
    if [[ "$due" != 0 ]]; then exit "$due"; fi
fi
[[ "$(stat -f -c %T /run)" == tmpfs ]] || { echo '/run must be tmpfs.' >&2; exit 1; }
[[ ! -L /run/cf-optimizer ]] || exit 1
install -d -m 750 -o cfoptimizer -g cfoptimizer /run/cf-optimizer
for family in -4 -6; do
    # A leftover exact rule from a previously killed scan may safely be removed.
    while ip "$family" rule del pref "$priority" uidrange "$uid-$uid" lookup main 2>/dev/null; do :; done
    if ip "$family" rule show | grep -q "^$priority:"; then
        echo "Routing priority $priority is already in use; aborting." >&2; exit 1
    fi
done
trap clean_runtime EXIT
# Remove stale reports from an interrupted run before a quiet health check.
clean_runtime
for family in -4 -6; do ip "$family" rule add pref "$priority" uidrange "$uid-$uid" lookup main; done
# Verify the IPv4 route really bypasses a tunnel. Rule collisions or missing main
# routes must fail before any measurements are published.
route=$(ip -4 route get 104.16.0.1 uid "$uid")
iface=$(awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}' <<< "$route")
[[ -n "$iface" && -d "/sys/class/net/$iface/device" ]] || { echo "Route is not through a physical network device: $route" >&2; exit 1; }
printf 'Scan traffic route: %s\n' "$route"
child=''
stop_child() { [[ -z "$child" ]] || kill -TERM "$child" 2>/dev/null || true; [[ -z "$child" ]] || wait "$child" 2>/dev/null || true; exit 143; }
trap stop_child TERM INT HUP
timeout --signal=TERM --kill-after=15s 40m runuser -u cfoptimizer -- \
    env -i PATH="$PATH" HOME=/run/cf-optimizer TMPDIR=/run/cf-optimizer PYTHONDONTWRITEBYTECODE=1 NOTIFY_SOCKET="${NOTIFY_SOCKET:-}" LANG=C.UTF-8 TZ=Asia/Shanghai \
    /bin/bash /opt/cf-optimizer/run_scan_linux.sh "$mode" &
child=$!
status=0
wait "$child" || status=$?
child=''
if [[ "$mode" == --health && "$status" == 75 ]]; then
    # Close the inherited lock before the forced refresh acquires it again.
    clean_runtime
    trap - EXIT TERM INT HUP
    exec 9>&-
    exec /usr/local/sbin/cf-optimizer --force
fi
if [[ ( "$mode" == --force || "$mode" == --scheduled || "$mode" == --health ) && -f /run/cf-optimizer/report.txt ]]; then
    # Restore normal Mihomo routing for Telegram after DIRECT measurements.
    remove_rules
    runuser -u cfoptimizer -- env -i PATH="$PATH" HOME=/run/cf-optimizer TMPDIR=/run/cf-optimizer PYTHONDONTWRITEBYTECODE=1 NOTIFY_SOCKET="${NOTIFY_SOCKET:-}" LANG=C.UTF-8 TZ=Asia/Shanghai \
        /bin/bash /opt/cf-optimizer/telegram_notify.sh || status=1
fi
exit "$status"
