[Unit]
Description=Private Telegram commands for Cloudflare A/AAAA switching
Wants=network-online.target
After=network-online.target mihomo.service systemd-tmpfiles-setup.service

[Service]
Type=simple
User=cfoptimizer
Group=cfoptimizer
ExecStart=/bin/bash /opt/cf-optimizer/telegram_control.sh
Restart=on-failure
RestartSec=30s
TimeoutStopSec=10s
RuntimeDirectory=cf-optimizer-bot
RuntimeDirectoryMode=0700
StandardOutput=null
StandardError=null
LogLevelMax=0
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/cf-optimizer-bot
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=96M
MemorySwapMax=0
LimitCORE=0

[Install]
WantedBy=multi-user.target
